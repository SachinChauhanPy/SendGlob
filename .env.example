# Django Settings
SECRET_KEY=django-insecure-example-secret-key-1234567890
DEBUG=True
ALLOWED_HOSTS=*

# Production (DEBUG=False): startup fails if SECRET_KEY is the insecure default
# or ALLOWED_HOSTS contains '*'. HTTPS hardening switches on automatically.
# SECURE_PROXY_SSL_HEADER=True        # only behind a proxy that sets X-Forwarded-Proto
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# LOG_LEVEL=INFO

